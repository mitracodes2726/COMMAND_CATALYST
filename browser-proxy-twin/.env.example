# Copy to .env and edit. The server reads these from the environment.
PTWIN_HOST=127.0.0.1
PTWIN_PORT=8080
# Seconds a slot stays held while the owner / user decides
PTWIN_HOLD_TTL=120
# Max requests per minute per client
PTWIN_RATE_LIMIT=600
# Optional: save registered cards to this JSON file so they survive restarts
# PTWIN_DATA=data/cards.json

# Reserved for the planned LLM onboarding and WhatsApp integrations. NOT used yet.
# LLM_API_KEY=
# WHATSAPP_TOKEN=
